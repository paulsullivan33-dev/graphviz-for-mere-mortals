// A larger graph: 40 numbered stations on three loops.
graph Big {
    node [shape=circle, fontsize=10];
    L0N0 -- L0N1;
    L0N1 -- L0N2;
    L0N2 -- L0N3;
    L0N3 -- L0N4;
    L0N4 -- L0N5;
    L0N5 -- L0N6;
    L0N6 -- L0N7;
    L0N7 -- L0N8;
    L0N8 -- L0N9;
    L0N9 -- L0N10;
    L0N10 -- L0N11;
    L0N11 -- L0N12;
    L0N12 -- L0N13;
    L0N13 -- L0N0;
    L1N0 -- L1N1;
    L1N1 -- L1N2;
    L1N2 -- L1N3;
    L1N3 -- L1N4;
    L1N4 -- L1N5;
    L1N5 -- L1N6;
    L1N6 -- L1N7;
    L1N7 -- L1N8;
    L1N8 -- L1N9;
    L1N9 -- L1N10;
    L1N10 -- L1N11;
    L1N11 -- L1N12;
    L1N12 -- L1N13;
    L1N13 -- L1N0;
    L2N0 -- L2N1;
    L2N1 -- L2N2;
    L2N2 -- L2N3;
    L2N3 -- L2N4;
    L2N4 -- L2N5;
    L2N5 -- L2N6;
    L2N6 -- L2N7;
    L2N7 -- L2N8;
    L2N8 -- L2N9;
    L2N9 -- L2N10;
    L2N10 -- L2N11;
    L2N11 -- L2N0;
    L0N0 -- L1N0;
    L1N0 -- L2N0;
}
